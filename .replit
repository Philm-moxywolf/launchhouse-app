# .replit
#
# WHAT THIS IS. The machine definition for the Replit workspace: which language modules are
# installed, what "Run" does, and which port is exposed.
#
# WHY IT EXISTS. Everything about how this app boots has to be under review, in the repo,
# where somebody can read it. A setting that lives only in a web pane is a setting nobody
# can diff, and this project has one VM and one weekend.
#
# WHAT READS IT. The Replit workspace. The Deployment reads its own configuration, which is
# NOT in this file, and the note further down says why.

# One command, and it is the whole start sequence. There is deliberately no `npm run
# db:migrate &&` in front of it.
#
# THIS LINE USED TO BE THE BUG. `npm run start` did not migrate, the deployment build command
# did not migrate, and nothing else ran. So a founder created a Replit database, set a
# passphrase, pressed Sign in, and got a 500 carrying an incident id and the words "tell a
# mentor", while the log said relation "founder" does not exist. Every founder hit it, within
# minutes of remixing, before doing anything wrong.
#
# THE FIX IS NOT IN THIS FILE, AND THAT IS ON PURPOSE. src/server/index.ts migrates at boot,
# before it binds the port. Chaining the migration here instead would work in the workspace
# and cover nothing else: the Deployment has its own run command, set in a web pane, and a
# fix that lives in two places is a fix that gets applied to one of them. Boot is the one
# place every start goes through, workspace and deployment alike.
#
# THE SAME LINE WAS THE BUG A SECOND TIME, ONE LAYER UP, AND THE FIX IS THE SAME SHAPE.
# `npm run start` did not build the browser bundle either, dist/ is gitignored, and nothing
# else built it. So a founder pressed Run and got three lines of HTML: "The app is running.
# The browser part has not been built yet", one Sign in link that came back to the same page,
# and 404 on everything else. The build command existed only in a comment at the bottom of
# this file, for a person to paste into a web pane. No founder was ever going to read it.
#
# THE FIX IS NOW IN package.json, AS `prestart`, FOR THE MIGRATION'S REASON. npm runs
# `prestart` before `start`, so it runs on the workspace Run button and on the deployment run
# command, both of which are `npm run start`. That is the one place every start goes through.
# Chaining `npm run build:web &&` here would cover the workspace and leave the deployment
# uncovered, which is the mistake the migration note above is about.
#
# IT BUILDS ONLY WHEN THERE IS NOTHING TO SERVE, so a restart does not wait for a build it
# does not need, and it NEVER FAILS THE START. A build that dies for want of memory must not
# leave a founder with a container that restarts for ever behind an address that never
# answers. It prints a line and the server comes up anyway.
#
# THE CAVEAT THAT CANNOT BE CLOSED FROM HERE, and the design works either way: nobody here
# has run a spike to find out whether pressing Run in a Replit workspace triggers a build of
# its own first. If it does, dist/web/index.html is already there and `prestart` skips in
# milliseconds. If it does not, `prestart` is the thing that builds it. Neither answer
# changes what a founder gets.
run = "npm run start"
entrypoint = "src/server/index.ts"
modules = ["web", "nix", "nodejs-22"]

[nix]
channel = "stable-25_05"

[env]
# The server process runs in UTC and converts at exactly two edges: rendering a time to a
# founder, and building a schedule value for GoHighLevel. A founder in Atlanta logging at
# 22:00 on the 24th must not get a heading dated the 25th, and ops-log.md is append only so
# it cannot be corrected afterwards. env.ts asserts this is UTC and refuses to start if it
# is not.
TZ = "UTC"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# =========================================================================================
# Deployment: configure it in the Deployments pane, not here.
# =========================================================================================
#
# There is deliberately no [deployment] section in this file. The key names under it have
# changed more than once, and a stale key written from memory produces a deployment that
# looks configured and is not. Open the Deployments pane and set it there.
#
# Choose RESERVED VM, not Autoscale. Four reasons, all specific to this product:
#
#   1. A turn that reads three files and writes one runs 30 to 180 seconds. Autoscale bills
#      per request second and enforces request timeouts.
#   2. SSE connections are long lived and idle for minutes while a founder types. Autoscale
#      scales to zero and cuts them.
#   3. Each live session is a spawned CLI subprocess held between turns. That wants a stable
#      machine, not one that may be replaced between two sentences of an interview.
#   4. The queue and the live session map are in memory. One VM means one place that state
#      lives, and one advisory lock holder.
#
# Starting size: 4 vCPU and 8 GB. That number is a guess until resident memory per live
# subprocess has been measured on the real machine. Measure before the freeze.
#
# The honest cost of one VM is that it is a single point of failure. The mitigation is that
# every durable thing is in Postgres, so a restart loses only in flight turns and those re
# queue from the turns table on boot.
#
# Build command:  npm ci && npm run build
# Run command:    npm run start
#
# BOTH OF THOSE NOW BUILD THE BROWSER BUNDLE, and that repetition is deliberate rather than
# sloppy. `npm run build` builds it here, at build time, where it belongs and where a failure
# stops the deployment going green. `prestart` builds it again on the run command only if it
# is not there, which is what covers a deployment whose build command was never set, or was
# set to something else, or was set in a pane somebody edited last month. The second one is
# cheap when the first one worked: it is a single test for a file.
#
# DO NOT ADD `npm run db:migrate` TO THE BUILD COMMAND. It is the obvious next thought and it
# is wrong twice over. The build runs at a different moment from the app, and whether a
# Replit build step is handed DATABASE_URL is a vendor detail no spike here has verified, so
# a build that migrates is a build that may fail on an environment variable that was never
# missing. And a founder redeploying an existing app would migrate at build time against a
# database the running container is still using. The app migrates at boot instead, where the
# environment is the one it will actually run under. See src/server/boot/schema.ts.
#
# `npm ci` and NOT `npm install`, and not either with --no-optional. The CLI the agent loop
# spawns is a per platform OPTIONAL dependency. Skip it and the deployment goes green and
# fails at the founder's first message. Boot now refuses to report ready without it, so this
# shows up as a start page rather than as a broken conversation, but the build command is
# where it is avoided in the first place.
#
# For the deployment probe, and only for the probe, the run command is: npm run probe
# See scripts/PROBE.md.
