# .env.example
#
# WHAT THIS IS. Every environment variable the app reads, named, with what it is for and
# what breaks without it. It is the checklist somebody works down when they set up a new
# deployment.
#
# WHY IT EXISTS. src/server/env.ts refuses to start the process when a required variable is
# missing or malformed. That refusal is only kind if there is somewhere to look up what the
# variable was. This is that place.
#
# THERE ARE NO VALUES IN THIS FILE AND THERE NEVER WILL BE. Not a placeholder that looks
# real, not a development key, not an example token. A file of shaped fake values teaches
# people to copy without reading, and one day the fake one is real. Copy this to .env and
# fill it in from a password manager, or set the values in Replit Secrets.
#
# Where a variable has a default, the default is written in the comment. It is not written
# as a value, because a commented default cannot be committed by accident.


# =========================================================================================
# Runtime and identity
# =========================================================================================

# Node's own mode. One of: development, production, test.
# Affects library behaviour, not ours. APP_ENV below is the one our code branches on.
NODE_ENV=

# Which of the three environments this process is. One of: dev, preview, prod.
# dev is a laptop with seeded fictional founders. preview is the Replit deployment the team
# and the client look at. prod is the 130. These never share a database, a bucket or a key,
# and env.ts enforces several of the differences.
APP_ENV=

# The port to bind on 0.0.0.0. Replit supplies this. Default 5000 when unset.
PORT=

# Must be the three letters UTC. The server process runs in UTC and converts at exactly two
# edges: rendering a time to a founder, and building a schedule value for GoHighLevel.
# Every other date in the system is UTC or an IANA zone name carried beside it.
TZ=

# The absolute public URL of this deployment, no trailing slash, for example the preview or
# prod domain. Magic link emails are built from it. Get it wrong and 130 sign in links point
# somewhere that does not exist.
APP_BASE_URL=

# pino level. One of: trace, debug, info, warn, error, fatal. Default info.
LOG_LEVEL=


# =========================================================================================
# Database. Postgres is the record. Everything else is a cache.
# =========================================================================================

# Postgres connection string. Replit supplies this in the workspace.
DATABASE_URL=

# The environment this database belongs to: dev, preview or prod. It must equal APP_ENV.
# This is the guard against the accident that ends this project, which is a preview process
# pointed at the prod database and writing over a founder's Brain. Required when APP_ENV is
# prod. Strongly recommended everywhere.
DATABASE_ENV_TAG=


# =========================================================================================
# Encryption. Every founder blob is encrypted, not just the ones holding people.
# =========================================================================================

# The master key that wraps each founder's own data key. 32 bytes, base64 encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this loses every founder's work. It is escrowed offline, by a named person, on a
# named date, before the first founder signs in. That is a checklist item, not a hope.
# Anyone holding both this key and a database dump can decrypt all 130. That is the real
# threat model. The design keeps the two apart so a database leak alone is not a key leak.
GE_MASTER_KEY=

# Which key version GE_MASTER_KEY is. Integer, default 1. Rotation is additive: add the new
# key, bump this number, and rows re encrypt lazily as they are next written.
GE_MASTER_KEY_VERSION=


# =========================================================================================
# The model
# =========================================================================================

# The API key funding all 130 founders. On a laptop each founder funded their own plan.
# Here one key funds a cohort across three sessions and a weekend, which is why the spend
# caps below are required rather than optional.
ANTHROPIC_API_KEY=

# Model ids. There is deliberately no default for these two.
#
# A model id baked into the source is a cached table that goes stale silently, and the build
# document lists "model ids and list prices" as an assumption to check at build time rather
# than trust. Making them required environment variables forces somebody to look the current
# ids up on the day rather than inherit a guess.
#
# MODEL_PRIMARY runs the Brain, content, outreach, audience, ops copy and the 90 day plan.
# That is the product: copy in the founder's own voice with no invented proof.
MODEL_PRIMARY=

# MODEL_UTILITY runs status, gate, doctor and the thread digests. Reading files and
# reporting. No voice work, so it does not need the strongest model.
MODEL_UTILITY=

# Optional. Passed as fallbackModel on the primary routes so a capacity blip degrades
# instead of stalling a founder mid interview. Leave blank to switch fallback off.
MODEL_FALLBACK=


# =========================================================================================
# Limits. Every number here is a starting guess until it is measured on the real VM.
# =========================================================================================

# Concurrent agent runs. Default 24. Protects RAM and CPU. Tune from measured resident
# memory per live subprocess, which nobody has measured yet.
MAX_CONCURRENT_RUNS=

# Live CLI subprocesses held between turns. Default 60. Above this, evict the oldest idle
# one, keeping its session id so it can be resumed.
MAX_LIVE_SESSIONS=

# Milliseconds a session may sit with no turn before its subprocess is torn down.
# Default 600000, which is ten minutes.
SESSION_IDLE_MS=

# Milliseconds between SSE heartbeat comments. Default 15000.
# Fifteen seconds is a guess. It must sit comfortably under the Replit proxy's real idle
# timeout, and that number comes from scripts/probe-deployment.ts. Set it after the probe.
SSE_HEARTBEAT_MS=

# Token bucket per founder. Defaults 30 an hour and 200 a day. These catch a looping
# client, not a busy founder.
RATE_TURNS_PER_HOUR=
RATE_TURNS_PER_DAY=


# =========================================================================================
# Spend caps. All three are required and none has a default, on purpose.
# =========================================================================================
#
# A cap with a default is a cap nobody chose. Somebody has to type a number, which means
# somebody has to think about it. Real cost per engine per track is not known yet: it comes
# from the two demo founder end to end runs, and the founder cap gets fixed after those,
# not before.

# Hard ceiling for a single turn, in US dollars. Passed to the SDK as maxBudgetUsd, so it
# kills a runaway inside the loop rather than after a poll.
TURN_SPEND_CAP_USD=

# Ceiling for one founder across the whole programme, in US dollars. The queue refuses a
# turn when a founder has reached it, and the founder gets a plain sentence and a route to
# a human, never a silent failure.
FOUNDER_SPEND_CAP_USD=

# The cohort breaker. A global daily ceiling in US dollars. Crossing it refuses new turns
# and fires an alert. This is the one that stops a bug billing 130 people at 3am.
COHORT_DAILY_CAP_USD=


# =========================================================================================
# ge, the shell engine. The app writes founder state only through it.
# =========================================================================================

# Absolute or repo relative path to the ge entry point inside the pinned submodule.
# Default vendor/growth-engine/plugins/growth-engine/bin/ge
# If this is missing the submodule was not initialised: git submodule update --init
GE_BIN=

# The shell ge is run under. Default /bin/sh.
# ge is POSIX sh and its test suite runs under both sh and dash. It is spawned as
# spawn(GE_SHELL, [GE_BIN, ...argv]) with an argv array and never with shell: true, so
# anything a founder types arrives as one argument and cannot be read as shell.
GE_SHELL=

# Milliseconds before a ge invocation is killed. Default 20000.
# ge does small file work on small files. A verb that has not returned in twenty seconds is
# stuck, and a stuck verb holds the founder's advisory lock.
GE_TIMEOUT_MS=

# Root of the per founder scratch folders. Default /tmp/ge
# One folder per founder id underneath. It is a cache, it is not durable, and the deployment
# filesystem may be wiped at any restart. That is by design and the storage turn assumes it.
WORKSPACE_ROOT=


# =========================================================================================
# Mail. Sign in is a magic link, so the mailer is on the critical path for all 130.
# =========================================================================================
#
# The provider is not chosen yet. Delivery to Gmail, Outlook.com and a Microsoft 365 mailbox
# is an open blocker and it is needed well before the 4 September onboarding email. When the
# provider is chosen, its variables are added here and to env.ts, and nowhere else.

# How mail leaves the process. One of: log, smtp.
# log prints the email to the server log and sends nothing, which is what a laptop wants.
# env.ts refuses to start in prod with this set to log, because a prod deployment that
# cannot send mail is a prod deployment nobody can sign in to.
MAIL_TRANSPORT=

# The From address on sign in emails.
MAIL_FROM=

# Comma separated list of addresses that may receive mail outside prod.
# Required when APP_ENV is dev or preview, and the mailer throws on a recipient not in it.
# Seeded founders have plausible looking addresses, and this is what stops a test run
# emailing a real person. Ignored in prod, where the roster is the list.
MAIL_ALLOWLIST=

# SMTP connection URL. Required only when MAIL_TRANSPORT is smtp.
SMTP_URL=


# =========================================================================================
# Backups and alerts
# =========================================================================================

# Replit Object Storage bucket for the nightly per founder backup.
# Leave blank and the nightly backup is switched off, and the boot log says so out loud
# rather than pretending it ran. Whether Object Storage even works from inside a deployment,
# as opposed to from the workspace, is one of the things the probe answers.
OBJECT_STORAGE_BUCKET_ID=

# Optional. Where the cohort breaker and the nightly audit checks send an alert.
# The channel is not chosen yet. Leave blank and alerts go to the log only.
ALERT_WEBHOOK_URL=


# =========================================================================================
# Sessions and sign in
# =========================================================================================

# Session cookie name. Default lh_session.
SESSION_COOKIE_NAME=

# Session lifetime in days, sliding. Default 90.
# Long on purpose. Nobody stands in the Atlanta venue on the Friday unable to get in.
SESSION_TTL_DAYS=

# Sign in link lifetime in minutes. Default 30, not the usual 15.
# These are not developers. Somebody will read the email on their phone and walk to their
# laptop.
SIGNIN_TOKEN_TTL_MINUTES=


# =========================================================================================
# The deployment probe only. scripts/probe-deployment.ts reads these. The app does not.
# =========================================================================================

# A throwaway value, set in the Replit workspace Secrets pane and never promoted by hand.
# The probe reports whether it arrived in the Deployment, and reports only its length and a
# short hash, never the value. Set it to any random string. Delete it after the probe.
PROBE_SECRET=

# Optional. The probe's own public URL, pasted in after the first deploy. When set, the
# probe opens an SSE stream to itself through the Replit proxy and times the disconnect,
# which answers the heartbeat question without anybody having to leave a browser tab open.
PROBE_PUBLIC_URL=

# Optional. Where the probe keeps its boot marker. Default .probe-state next to the app.
# The probe writes a second marker under /tmp regardless, because the two mounts can behave
# differently and the difference is the whole question.
PROBE_STATE_DIR=


# =========================================================================================
# Variables the platform supplies
# =========================================================================================
#
# Replit sets several variables of its own. They are deliberately not listed here, because
# guessing their names from memory is how a boot check ends up testing a variable that does
# not exist. The probe prints every variable name present in the deployment, with values
# redacted, and the real names get written down from that output.
#
# Nothing in this app requires a platform variable to start.


# =========================================================================================
# Variables that must NEVER exist in this file or in any environment
# =========================================================================================
#
# There is no GHL_TOKEN. There is no APOLLO_API_KEY. There is no ambient vendor credential
# of any kind, at any level.
#
# Every vendor credential belongs to exactly one founder, is stored encrypted in the
# database bound cryptographically to that founder's id, and is decrypted at the call site
# for the length of one request. A process wide vendor token is a credential with no owner,
# and a credential with no owner is how founder A's post ends up in founder B's account.
#
# env.ts refuses to boot if it finds one. That refusal is the point.
